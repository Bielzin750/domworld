# Obrigatório: segredo próprio, aleatório, com pelo menos 32 caracteres.
RL_SECRET=YOUR_DOMWORLD_LOBBY_SECRET

# Rotação opcional do segredo anterior; deixe vazio para desativar.
RL_SECRET_OLD=
RL_SECRET_OLD_UNTIL=0

# Serviço HTTP.
PORT=3002
HOST=0.0.0.0
LOBBIES=1
CLOCK_SKEW=120
LOG_LEVEL=info

# Caminhos de persistência. Use "off" para desativar snapshots locais.
STATE_FILE=state.json
RL_DIR=.

# Obrigatório apenas se a página de estatísticas for habilitada.
STATS_PASSWORD=YOUR_DOMWORLD_STATS_PASSWORD

